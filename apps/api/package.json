{
  "name": "@avo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "mcp": "tsx src/mcp-server.ts",
    "build": "tsup src/index.ts src/mcp-server.ts --format esm --clean --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:codex": "tsx scripts/codex-mcp-smoke.ts"
  },
  "dependencies": {
    "@avo/contracts": "workspace:*",
    "@avo/core": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "zod": "^3.25.76"
  }
}
