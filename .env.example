AVO_HOST=127.0.0.1
AVO_API_PORT=4310
AVO_WEB_PORT=4311
AVO_DATA_DIR=./data
AVO_PROVIDER_MODE=fake
AVO_CODEX_BIN=codex
AVO_CODEX_MODEL=qwen3.8-max
AVO_CODEX_EFFORT=medium
AVO_CODEX_MAX_OUTPUT_TOKENS=8192
AVO_CODEX_MODEL_CATALOG=
AVO_CODEX_PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AVO_CODEX_PROVIDER_API_KEY=
AVO_CODEX_TURN_TIMEOUT_MS=600000
AVO_AGENT_TOKEN_WARNING=600000
# Optional explicit experiment limits. Empty means wall-time and tool limits only.
AVO_AGENT_TOKEN_LIMIT=
AVO_AGENT_STEP_TOKEN_LIMIT=
AVO_AGENT_STEP_SOFT_TIMEOUT_MS=900000
AVO_AGENT_STEP_TIMEOUT_MS=1200000
AVO_AGENT_CONTEXT_WINDOW=1000000
AVO_AGENT_PREVIEW_MAX_EDGE=1024
AVO_AGENT_TOOL_OUTPUT_MAX_CHARS=12000
AVO_BENCHMARK_CONCURRENCY=3
OPENAI_API_KEY=
AVO_IMAGE_BASE_URL=http://192.168.110.79:3000/v1
AVO_IMAGE_MODEL=gpt-image-2
AVO_IMAGE_PROVIDER_REVISION=
AVO_IMAGE_TASK_TIMEOUT_MS=1200000
# One AVO generate stays hidden from the Agent while the adapter retries up to five Provider submissions.
AVO_IMAGE_ATTEMPT_TIMEOUT_MS=120000
AVO_IMAGE_MAX_ATTEMPTS=5
AVO_RUN_LIVE_PROBES=false
AVO_PROVIDER_PROBE_TIMEOUT_MS=180000
QWEN_API_KEY=
QWEN_BILLING_MODE=token_plan
# Token Plan mode ignores old general-key/provider overrides and never falls back.
QWEN_TOKEN_PLAN_API_KEY=
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_PROVIDER_REVISION=
# Roles are independent. Secrets belong in ignored .env.local.
AVO_MAIN_PROVIDER=qwen
AVO_VERIFIER_PROVIDER=qwen
AVO_SUPERVISOR_PROVIDER=qwen
AVO_78CODE_BASE_URL=https://www.78code.cc/v1
AVO_78CODE_MODEL=gpt-6-astra
# AVO_78CODE_API_KEY=
# Optional: use your existing proxy only when direct routing fails.
# AVO_78CODE_PROXY_URL=http://127.0.0.1:7897
AVO_VERIFIER_EFFORT=low
# Temporary mitigation for slow Verifier requests; includes retries and stream reads.
AVO_VERIFIER_REQUEST_TIMEOUT_MS=360000
AVO_SUPERVISOR_EFFORT=high
